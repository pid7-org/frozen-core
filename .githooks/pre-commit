#!/usr/bin/env bash
set -e

TARGETS=(
  "x86_64-unknown-linux-gnu"
  "aarch64-unknown-linux-gnu"
  "x86_64-pc-windows-msvc"
  "aarch64-pc-windows-msvc"
  "x86_64-apple-darwin"
  "aarch64-apple-darwin"
)

# Extract MSRV from Cargo.toml (fallback to 1.86.0)
MSRV=$(grep -m 1 '^rust-version' Cargo.toml | cut -d '"' -f 2)
if [ -z "$MSRV" ]; then
  MSRV="1.86.0"
fi

echo "Running pre-commit checks..."

echo "==> Running cargo check (lib, tests, benches) across all 6 targets (Linux, Windows, macOS x x86_64, aarch64)..."
for target in "${TARGETS[@]}"; do
  echo "    Checking target: $target"
  cargo check --all-features --release --target "$target"
  cargo check --tests --benches --all-features --release --target "$target"
done

echo "==> cargo fmt --check"
cargo fmt --check

echo "==> Running cargo clippy across all 6 targets..."
for target in "${TARGETS[@]}"; do
  echo "    Clippy target: $target"
  cargo clippy --all-features --release --target "$target" -- -D warnings
done

echo "==> Running tests on host target (release)..."
cargo test --all-features --release -- --nocapture

if command -v rustup >/dev/null 2>&1 && rustup toolchain list | grep -q "$MSRV"; then
  echo "==> Running MSRV ($MSRV) verification checks..."
  echo "    Checking MSRV fmt..."
  cargo +"$MSRV" fmt --check
  echo "    Checking MSRV clippy..."
  cargo +"$MSRV" clippy --all-features --release -- -D warnings
  echo "    Checking MSRV (lib, tests, benches)..."
  cargo +"$MSRV" check --release --all-features
  cargo +"$MSRV" check --tests --benches --release --all-features
  echo "    Running MSRV tests..."
  cargo +"$MSRV" test --all-features --release -- --nocapture
else
  echo "==> Warning: Rust toolchain $MSRV not found; skipping MSRV checks."
fi

echo "All pre-commit checks passed!"
